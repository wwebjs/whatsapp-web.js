# Copy to ".env" (same folder) and fill in. ".env" is git-ignored. Never share these keys.

# Claude API key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# dev.to API key: https://dev.to/settings/extensions  ("DEV Community API Keys")
DEVTO_API_KEY=

# draft = save unpublished drafts (default, recommended while you check quality)
# live  = publish when the automatic review approves (otherwise saves a draft)
# dry   = print only, publish nothing
PUBLISH_MODE=draft

# Optional
# AREAS=AI,Python,Cloud,Machine Learning
# ARTICLE_MODEL=claude-opus-5-5
# ARTICLE_DISCLOSURE=Your own wording for the AI-assistance line (it is always added)
