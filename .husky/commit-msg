# Normalize commit type to lowercase (POSIX awk, so it works with BSD and GNU tools alike).
# Only the header is touched: the first line that is not blank or a git comment.
awk '!done && NF && !/^#/ { done = 1; if (match($0, /^[A-Za-z]+/)) $0 = tolower(substr($0, 1, RLENGTH)) substr($0, RLENGTH + 1) } { print }' "$1" > "$1.tmp" && mv "$1.tmp" "$1"

npx --no-install commitlint --edit "$1"
