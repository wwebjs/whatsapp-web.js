# Copy this file to ".env" (same folder) and fill in your keys. ".env" is git-ignored.
# Never paste these keys into chats, issues or commits.

# Claude API key: https://console.anthropic.com  (needed for article ideas and drafts)
ANTHROPIC_API_KEY=

# dev.to API key: https://dev.to/settings/extensions  ("DEV Community API Keys")
DEVTO_API_KEY=

# Optional
# ARTICLE_MODEL=claude-opus-5-5
# ARTICLE_DISCLOSURE=This article was drafted with AI assistance (Claude) and reviewed and edited by the author before publishing.
